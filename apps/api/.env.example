# Sunspark API (Express + MariaDB) environment.
#
# Copy to apps/api/.env and fill in real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

DATABASE_URL="mysql://root@localhost:3306/sunspark"

# Shared secret between the storefront and this API. Requests to /admin and to
# the customer order endpoints must present it as x-sunspark-admin-token. Must
# match API_ADMIN_TOKEN in the storefront .env exactly. When unset, every
# protected route returns 503 rather than opening up.
API_ADMIN_TOKEN="generate-a-long-random-secret"

# Comma-separated browser origins allowed by CORS. When unset, browser requests
# are denied outright (server-to-server calls, which send no Origin, still pass).
FRONTEND_ORIGIN="https://www.sunsparkelectricals.co.ke,https://sunsparkelectricals.co.ke"

# Seeds the first admin account on `npm run seed`. Change the password before launch.
ADMIN_EMAIL="admin@sunsparkelectricals.co.ke"
ADMIN_PASSWORD="Password"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port this API listens on. Default: 4000
PORT=4000

# Public base URL of this API, used to build absolute image URLs.
# Falls back to NEXT_PUBLIC_API_URL.
# API_PUBLIC_URL="https://backend.sunsparkelectricals.co.ke"

# Honour cf-connecting-ip / x-forwarded-for when identifying clients for rate
# limiting. Only enable when a proxy you control rewrites those headers -
# otherwise a caller can spoof them and rotate past the login rate limit.
# Default: false
# TRUST_PROXY_HEADERS="false"

# MariaDB connection pool size. Default: 5
# DB_POOL_SIZE="5"

# Contact details surfaced in emails, receipts, and the storefront footer.
REPORT_EMAIL="sunsparkelectricalsandsolar@gmail.com"
SUPPORT_EMAIL="support@sunsparkelectricals.co.ke"
WHATSAPP_PHONE="254703586562"
# SUPPORT_PHONE=""

# Outbound mail. Leave SMTP_HOST empty to disable delivery.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sunspark Electricals <support@sunsparkelectricals.co.ke>"

# Set to 1 to log emails instead of sending them (useful locally).
# EMAIL_DISABLE_DELIVERY="0"

# One-off product import switches, read only by the import scripts.
# PRODUCT_IMPORT_PRODUCTS_JSON=""
# PRODUCT_IMPORT_OPTIONS_JSON=""
# PRODUCT_IMPORT_UPDATE_STOCK="0"
# PRODUCT_IMPORT_FORCE_INACTIVE="0"

# ---------------------------------------------------------------------------
# Celcom Africa bulk SMS (API service only - these must never reach the browser)
#
# Get the key and the partner ID from the Celcom dashboard under
# "GET API KEY & PARTNER ID". A sender ID (shortcode) must be registered and
# approved by Celcom before it will deliver; until then sends are rejected with
# code 1001.
#
# SMS stays completely inert until the key, the partner ID, and at least one
# sender ID are all set, so this file is safe to deploy before the account exists.
# ---------------------------------------------------------------------------
CELCOM_SMS_API_KEY=""
CELCOM_SMS_PARTNER_ID=""

# Celcom issues two sender IDs on one account and one API key: one cleared for
# transactional traffic (order received, processing, complete, walk-in sale) and
# one for promotional traffic (bulk campaigns). The system picks the right one from
# the kind of message being sent - nobody chooses it in the admin.
#
# Each reads its own variable and only its own. There is no fallback between them and
# no shared catch-all, so whichever is left empty means that kind of message is
# refused outright, with a message naming the variable that would fix it.
#
# That is not fussiness. Marketing sent under a transactional shortcode is what gets
# the shortcode revoked, and losing it would stop the order confirmations too. Making
# each one explicit means nothing is ever sent under an ID that merely happened to be
# configured for something else.
CELCOM_SMS_SENDER_ID_TRANSACTIONAL=""
CELCOM_SMS_SENDER_ID_PROMOTIONAL=""

# Endpoints. Only set these if Celcom moves them; the documented defaults are
# built in. Note there is no trailing slash - the live getbalance service
# answers with an empty body when one is present.
# CELCOM_SMS_SEND_URL="https://isms.celcomafrica.com/api/services/sendsms"
# CELCOM_SMS_DLR_URL="https://isms.celcomafrica.com/api/services/getdlr"
# CELCOM_SMS_BALANCE_URL="https://isms.celcomafrica.com/api/services/getbalance"

# Kill switches. Transactional covers the order and walk-in messages; marketing
# covers bulk campaigns. Both default to on once credentials exist. Set to
# "false" to pause one without unsetting the credentials.
# CELCOM_SMS_TRANSACTIONAL_ENABLED="true"
# CELCOM_SMS_MARKETING_ENABLED="true"

# Set to "true" to compose and log every message without sending it. Use this to
# rehearse a campaign, or to run staging, without spending credits.
# CELCOM_SMS_DRY_RUN="false"

# Shown on the bulk SMS tab so whoever is topping up does not have to look it up.
# CELCOM_SMS_PAYBILL="2007272"
# CELCOM_SMS_PAYBILL_ACCOUNT="SUNSPARK"
# CELCOM_SMS_TOPUP_URL="https://celcomafrica.com"

# How every text signs off. The trading name is kept short because each character
# is billed; the phone number falls back to the WhatsApp number in site settings,
# and the website to NEXT_PUBLIC_SITE_URL with the protocol stripped.
# SMS_BRAND_NAME="Sunspark"
# Pin SMS_BRAND_WEBSITE rather than letting it fall back to NEXT_PUBLIC_SITE_URL:
# that value is "localhost:3000" on a dev machine, and a customer must never be sent
# a text telling them to visit it.
SMS_BRAND_WEBSITE="sunsparkelectricals.co.ke"
# SUPPORT_PHONE=""

# Pause between messages in a bulk email send, in milliseconds. Shared cPanel
# mailboxes cut a sender off for the rest of the hour when mail arrives faster
# than their limit allows. Default: 400
# BULK_EMAIL_DELAY_MS="400"
