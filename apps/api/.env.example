# Sunspark API (Express + MariaDB) environment.
#
# Copy to apps/api/.env and fill in real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

DATABASE_URL="mysql://root@localhost:3306/sunspark"

# Shared secret between the storefront and this API. Requests to /admin and to
# the customer order endpoints must present it as x-sunspark-admin-token. Must
# match API_ADMIN_TOKEN in the storefront .env exactly. When unset, every
# protected route returns 503 rather than opening up.
API_ADMIN_TOKEN="generate-a-long-random-secret"

# Comma-separated browser origins allowed by CORS. When unset, browser requests
# are denied outright (server-to-server calls, which send no Origin, still pass).
FRONTEND_ORIGIN="https://www.sunsparkelectricals.co.ke,https://sunsparkelectricals.co.ke"

# Seeds the first admin account on `npm run seed`. Change the password before launch.
ADMIN_EMAIL="admin@sunsparkelectricals.co.ke"
ADMIN_PASSWORD="Password"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port this API listens on. Default: 4000
PORT=4000

# Public base URL of this API, used to build absolute image URLs.
# Falls back to NEXT_PUBLIC_API_URL.
# API_PUBLIC_URL="https://backend.sunsparkelectricals.co.ke"

# Honour cf-connecting-ip / x-forwarded-for when identifying clients for rate
# limiting. Only enable when a proxy you control rewrites those headers -
# otherwise a caller can spoof them and rotate past the login rate limit.
# Default: false
# TRUST_PROXY_HEADERS="false"

# MariaDB connection pool size. Default: 5
# DB_POOL_SIZE="5"

# Contact details surfaced in emails, receipts, and the storefront footer.
REPORT_EMAIL="sunsparkelectricalsandsolar@gmail.com"
SUPPORT_EMAIL="support@sunsparkelectricals.co.ke"
WHATSAPP_PHONE="254703586562"
# SUPPORT_PHONE=""

# Outbound mail. Leave SMTP_HOST empty to disable delivery.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sunspark Electricals <support@sunsparkelectricals.co.ke>"

# Set to 1 to log emails instead of sending them (useful locally).
# EMAIL_DISABLE_DELIVERY="0"

# One-off product import switches, read only by the import scripts.
# PRODUCT_IMPORT_PRODUCTS_JSON=""
# PRODUCT_IMPORT_OPTIONS_JSON=""
# PRODUCT_IMPORT_UPDATE_STOCK="0"
# PRODUCT_IMPORT_FORCE_INACTIVE="0"
