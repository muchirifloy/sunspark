# Sunspark storefront (Next.js) environment.
#
# Copy to .env and fill in real values. The backend in apps/api has its own
# apps/api/.env - see apps/api/.env.example. Only the variables listed here are
# read by the storefront; anything else in this file is ignored at runtime.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs session cookies. Outside NODE_ENV=development the app refuses to start a
# session without this, rather than falling back to a shared default secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="use-a-long-random-secret"

# Shared secret between this app and apps/api. The backend rejects every
# /admin and customer-order request that does not present it, so the SAME value
# must be set here and in apps/api/.env. Without it the admin dashboard and
# order pages return 503.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ADMIN_TOKEN="generate-a-long-random-secret"

# Public origin of the storefront. Used for canonical URLs, sitemap, OpenGraph.
NEXT_PUBLIC_SITE_URL="https://sunsparkelectricals.co.ke"

# Backend base URL used by server-side fetches. API_INTERNAL_URL wins when set,
# which lets the server talk to the API over a private address while browsers
# use the public one.
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_INTERNAL_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Origin that serves uploaded product images. Falls back to NEXT_PUBLIC_API_URL.
# Also drives the allowed image hosts in next.config.ts and the Content-Security-Policy.
# NEXT_PUBLIC_BACKEND_URL="https://backend.sunsparkelectricals.co.ke"

# Google Maps browser key for the checkout delivery-location picker. Restrict it
# by HTTP referrer. Leave unset to fall back to manual address entry.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# GOOGLE_MAPS_BROWSER_API_KEY=""
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# How long catalogue reads (categories, products, campaigns) stay cached, in
# seconds. Admin edits clear the cache immediately regardless of this value.
# Default: 60
# CATALOG_REVALIDATE_SECONDS="60"

# Backend request tuning. Defaults: 12000 ms timeout, 1 retry for GET/HEAD.
# API_FETCH_TIMEOUT_MS="12000"
# API_FETCH_RETRIES="1"

# Port for `npm start` (server.js). Default: 3000
# PORT="3000"

# Outbound mail for password-reset and report emails sent from this app.
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Sunspark Electricals <support@sunsparkelectricals.co.ke>"
